# GEMINI_API_KEY: Required for Gemini API / Google AI Studio calls (when PROVIDER=api).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PROVIDER: Select 'api' (Google AI Studio Gemma 4) or 'local' (Ollama)
PROVIDER="api"

# Gemma 4 Model ID for Gemini API (Google AI Studio)
# Available models: gemma-4-31b-it (default) or gemma-4-26b-a4b-it
GEMMA_API_MODEL="gemma-4-31b-it"

# Ollama Settings (used when PROVIDER=local)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma4:e2b"

# APP_URL: Optional URL where this applet is hosted.
APP_URL="http://localhost:3000"
